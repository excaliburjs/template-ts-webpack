{
  "compilerOptions": {
    // Skips type-checking .d.ts files in node_modules, not your own code.
    // Required today: excalibur's shipped typings reference AddEvent/RemoveEvent
    // without their required type argument (entity.d.ts), which fails tsc.
    // Can be removed once that is fixed upstream.
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "moduleResolution": "node10",
    "target": "es2018",
    "module": "ESNext",
    "sourceMap": true,
    "outDir": "./dist/",
    "paths": {
      "@/*": [
        "./src/*"
      ],
    }
  }
}
